{
  "name": "caplead-prototype",
  "version": "1.0.0",
  "description": "Prototype generator for lead websites",
  "main": "electron/main.js",
  "scripts": {
    "start": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "setup-skills": "npm install playwright metascraper metascraper-image",
    "build": "vite build",
    "build:win": "npm run build && electron-builder --win dir --config electron-builder.yml",
    "lint": "eslint ."
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "lucide-react": "^0.364.0",
    "metascraper": "^5.17.0",
    "metascraper-image": "^5.17.0",
    "nodemailer": "^8.0.6",
    "playwright": "^1.34.0",
    "puppeteer": "^24.42.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sqlite3": "^6.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.2",
    "electron": "^25.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.4",
    "vite": "^5.2.2",
    "wait-on": "^7.2.0"
  }
}
